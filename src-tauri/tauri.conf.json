{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance Sistrum",
  "version": "0.2.0",
  "identifier": "com.audhd.resonance-sistrum",
  "build": {
    "beforeDevCommand": "npm run sync-android && npm run dev",
    "devUrl": "http://localhost:1448",
    "beforeBuildCommand": "npm run sync-android && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Resonance Sistrum",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/takes/*", "$APPDATA/takes/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
